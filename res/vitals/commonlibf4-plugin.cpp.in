// Generated by xmake from res/vitals/commonlibf4-plugin.cpp.in (Vitals' replacement for the library's default).
// Why a replacement: the library default sets only the Next-Gen (1.10.980) flags and lists only
// RUNTIME_LATEST. F4SE 0.7.5+ ignores the Next-Gen flags, so the default would load on 1.11.240 only.
// Here we list every build the pinned library supports. We deliberately do NOT claim
// "version independent" (no layout flags), so on an unknown future build F4SE skips Vitals with a
// log line rather than loading it and letting the library's whitelist terminate the game.
// We also do NOT set the Address Library flags: with them, F4SE refuses Vitals when the Address Library file is
// missing, which is exactly when a player needs the report. Vitals reads the file itself and never lets CommonLib's
// lookup end the game (src/Common.cpp, AddressLibrary()).
#include <F4SE/F4SE.h>

F4SE_PLUGIN_VERSION = []() noexcept {
    F4SE::PluginVersionData v{};
    v.PluginVersion({ ${COMMONLIB_PLUGIN_VERSION_MAJOR}, ${COMMONLIB_PLUGIN_VERSION_MINOR}, ${COMMONLIB_PLUGIN_VERSION_PATCH}, 0 });
    v.PluginName("${COMMONLIB_PLUGIN_NAME}");
    v.AuthorName("${COMMONLIB_PLUGIN_AUTHOR}");
    v.UsesSigScanning(false);
    v.UsesAddressLibraryNG(false);
    v.UsesAddressLibraryAE(false);
    v.HasNoStructUse(false);
    v.IsLayoutDependentNG(false);
    v.IsLayoutDependentAE(false);
    v.CompatibleVersions({
        F4SE::RUNTIME_1_10_980, F4SE::RUNTIME_1_10_984,
        REL::Version{ 1, 11, 137, 0 }, REL::Version{ 1, 11, 159, 0 }, REL::Version{ 1, 11, 169, 0 },
        REL::Version{ 1, 11, 191, 0 }, F4SE::RUNTIME_1_11_221, F4SE::RUNTIME_1_11_240 });
    v.MinimumRequiredXSEVersion({ 0, 7, 0, 0 });
    return v;
}();
